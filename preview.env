# The preview service of this repo is the relay of this worktree (read by compose.preview.yml).
# It files into a throwaway local store, never into GitHub issues; the papercuts service next to
# it is the relay of the main checkout, like in the preview of every app.
PAPERCUTS_STORE=local
PAPERCUTS_DB=/tmp/papercuts.db
PAPERCUTS_SHOTS_DIR=/tmp/shots
PAPERCUTS_HOST=0.0.0.0
# Any preview may post to it (one host label each, e.g. app-template--papercuts.review.t7d.dev).
PAPERCUTS_ORIGINS=https://*.review.t7d.dev
